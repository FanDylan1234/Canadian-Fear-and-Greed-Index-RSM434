{
  "folders": [
    {
      "path": ".."
    }
  ],
  "settings": {
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv",
    "python.terminal.activateEnvironment": true
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Canadian Fear & Greed: setup and run",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/runtostartindex.py",
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal",
        "justMyCode": true
      }
    ]
  }
}
